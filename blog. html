<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <!-- スマホの画面サイズに自動フィットさせる重要なタグ -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ゆいのブログ</title>
  <style>
    /* 全体リセット & 基礎スタイル */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      line-height: 1.6;
      background-color: #f4f6f9;
      color: #333333;
      padding-bottom: 40px;
    }

    /* ヘッダー */
    header {
      background-color: #2c3e50;
      color: #ffffff;
      text-align: center;
      padding: 24px 16px;
      margin-bottom: 24px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
    header h1 {
      font-size: 1.5rem;
      font-weight: bold;
    }
    header a {
      color: #ffffff;
      text-decoration: none;
    }
    header a:hover {
      text-decoration: underline;
    }

    /* メインコンテンツ（スマホ対応コンテナ） */
    .container {
      width: 100%;
      max-width: 600px; /* スマホ・タブレットで読みやすい幅 */
      margin: 0 auto;
      padding: 0 16px;
    }

    /* ブログ記事カード */
    .post-card {
      background-color: #ffffff;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 20px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.05);
      border: 1px solid #e1e8ed;
    }
    .post-title {
      font-size: 1.25rem;
      color: #1a252f;
      margin-bottom: 8px;
    }
    .post-meta {
      font-size: 0.85rem;
      color: #7f8c8d;
      margin-bottom: 16px;
    }
    .post-content {
      font-size: 1rem;
      white-space: pre-wrap; /* 改行を反映 */
      color: #2c3e50;
      line-height: 1.8;
      word-break: break-all;
    }
    .post-content a {
      color: #3498db;
    }

    /* コメント送信フォーム */
    .comment-form {
      background-color: #ffffff;
      border-radius: 12px;
      padding: 20px;
      margin-top: 30px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }
    .comment-form h3 {
      font-size: 1.1rem;
      margin-bottom: 12px;
    }
    .form-group {
      margin-bottom: 12px;
    }
    .form-group input, 
    .form-group textarea {
      width: 100%;
      padding: 12px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 1rem;
      outline: none;
    }
    .form-group textarea {
      resize: vertical;
      min-height: 80px;
    }
    .submit-btn {
      width: 100%;
      background-color: #3498db;
      color: white;
      border: none;
      padding: 12px;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      transition: background-color 0.2s;
    }
    .submit-btn:active {
      background-color: #2980b9;
    }

    /* パソコン（横幅600px以上）で見るときのアジャスト */
    @media (min-width: 600px) {
      header h1 {
        font-size: 2rem;
      }
      .post-card {
        padding: 28px;
      }
    }
  </style>
</head>
<body>

  <header>
    <!-- ヘッダータイトルをブログURLへのリンクに変更 -->
    <h1><a href="https://yasushikomine6-cell.github.io/blog.%20html">ゆいのブログ</a></h1>
  </header>

  <main class="container">
    <!-- 記事1 -->
    <article class="post-card">
      <h2 class="post-title">ゆいのブログじゃよ！</h2>
      <div class="post-meta">投稿日: 2026-07-29 | 投稿者: ゆい</div>
      <div class="post-content">今日からブログ始めるけぇ、みんな見ていってね！

ブログURL: <a href="https://yasushikomine6-cell.github.io/blog.%20html">https://yasushikomine6-cell.github.io/blog.%20html</a></div>
    </article>

    <!-- コメント入力エリア -->
    <section class="comment-form">
      <h3>コメントを残す</h3>
      <div class="form-group">
        <input type="text" placeholder="お名前">
      </div>
      <div class="form-group">
        <textarea placeholder="コメントを入力してね"></textarea>
      </div>
      <button class="submit-btn" type="button">送信する</button>
    </section>
  </main>

</body>
</html>
